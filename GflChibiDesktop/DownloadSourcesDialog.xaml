<UserControl x:Class="GflChibiDesktop.DownloadSourcesDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             Width="500" Height="236" Background="#FF1B1B1C" Foreground="White" >
    <hc:SimplePanel>
        <Border CornerRadius="10,10,0,0" Background="{DynamicResource PrimaryBrush}" Height="30" VerticalAlignment="Top">
            <hc:SimplePanel>
                <hc:SimpleText VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Stretch" TextAlignment="Center" Text="下载源设置" Foreground="{StaticResource PrimaryTextBrush}"/>
                <Image RenderTransformOrigin="0,0" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" Height="24" Width="24" HorizontalAlignment="Left" Source="hk416_angry.ico" VerticalAlignment="Top" Margin="3"/>
                <Button Width="24" Height="24" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource ErrorGeometry}" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Command="hc:ControlCommands.Close" Margin="3" />
            </hc:SimplePanel>
        </Border>
        <Label Content="下载源：" HorizontalAlignment="Left" Height="30" VerticalAlignment="Top" Width="48" Margin="10,33,0,0" Padding="0" Background="{x:Null}" BorderBrush="{x:Null}"/>
        <hc:TextBox x:Name="tb_downloadSource" HorizontalAlignment="Left" VerticalAlignment="Top" Width="426" Margin="64,33,0,0"  VerticalScrollBarVisibility="Disabled" MaxLines="1" IsReadOnly="True" BorderThickness="0" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0"/>
        <ListBox x:Name="lb_sources" HorizontalAlignment="Left" Height="122" VerticalAlignment="Top" Width="175" Margin="10,68,0,0" SelectionChanged="lb_sources_SelectionChanged" />
        <hc:TextBox x:Name="tb_sourceInfo" Height="122" VerticalAlignment="Top" Width="300" Margin="190,68,10,0" Padding="0" Background="{x:Null}" IsReadOnly="True" Text="未选择下载源" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" BorderThickness="0" TextWrapping="WrapWithOverflow"/>
        <Button x:Name="btn_UpdateSources" Content="刷新下载源" HorizontalAlignment="Left" Height="30" VerticalAlignment="Top" Width="175" Margin="10,196,0,0" Click="btn_UpdateSources_Click"/>
        <Button x:Name="btn_OK" Content="确定" HorizontalAlignment="Left" Height="30" VerticalAlignment="Top" Width="100" Margin="285,196,0,0" Click="btn_OK_Click" />
        <Button x:Name="btn_Cancel" Content="取消" HorizontalAlignment="Left" Height="30" VerticalAlignment="Top" Width="100" Margin="390,196,0,0" Command="hc:ControlCommands.Close" />
    </hc:SimplePanel>
</UserControl>
