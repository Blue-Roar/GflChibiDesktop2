<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>GflChibiDesktopLegacy</RootNamespace>
    <AssemblyName>GflChibiDesktopLegacyGL</AssemblyName>
    <StartupObject>GflChibiDesktop.App</StartupObject>
    <ApplicationIcon>hk416_happy.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Platforms>AnyCPU</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <NoWarn>$(NoWarn);SYSLIB0014;CA1416</NoWarn>
    <AssemblyTitle>少女前线桌面Q宠 MonoGame 运行模块 (OpenGL)</AssemblyTitle>
    <Description>少女前线桌面Q宠 MonoGame 运行模块 (OpenGL)</Description>
    <Company>BrightSu</Company>
    <Product>GflChibiDesktopLegacyGL</Product>
    <Copyright>© 2020~2026 BrightSu</Copyright>
    <AssemblyVersion>1.1.0.2</AssemblyVersion>
    <FileVersion>1.1.0.2</FileVersion>
    <!-- 与 DX 版同目录共存：独立 obj/bin（由 Directory.Build.props 设置 obj），并排除对方生成物 -->
    <OutputPath>bin\LegacyGL\$(Configuration)\</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.1.303" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="hk416_happy.ico" />
  </ItemGroup>

  <!-- huMessageQueue.dll 由 Ipc.cs 通过 P/Invoke 加载，必须与程序同目录 -->
  <ItemGroup>
    <None Include="huMessageQueue.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
