<Window x:Class="GflChibiDesktop2.CGWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GflChibiDesktop2"
        mc:Ignorable="d"
        Title="立绘" Background="{x:Null}" WindowStartupLocation="CenterScreen" Icon="/hk416_happy.ico" MouseMove="Move_MouseMove" Cursor="SizeAll" Focusable="False" IsTabStop="False" ResizeMode="NoResize" MouseWheel="Window_MouseWheel" MinWidth="256" MinHeight="256" ScrollViewer.VerticalScrollBarVisibility="Disabled" Topmost="True" AllowsTransparency="True" WindowStyle="None" IsHitTestVisibleChanged="Window_IsHitTestVisibleChanged" Loaded="Window_Loaded" Width="512" Height="512" >
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="tii">
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfoCollection>
                    <ThumbButtonInfo x:Name="tbtn_reset"
                                     DismissWhenClicked="False"
                                     Description="重置立绘状态"
                                     ImageSource="/hk416_angry.ico" Click="tbtn_reset_Click" />
                </ThumbButtonInfoCollection>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <Grid>
        <Viewbox x:Name="vb_img" Width="512" Height="512">
            <Image x:Name="ImageCG" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="menuItem_dummy" Header="(未加载立绘)" IsEnabled="False"/>
                        <MenuItem x:Name="menuItem_d" Header="大破立绘" IsCheckable="True" Unchecked="menuItem_d_Unchecked" Checked="menuItem_d_Checked" />
                        <Separator/>
                        <MenuItem Header="缩放">
                            <MenuItem x:Name="menuItem_zoom200" Header="200%" Click="menuItem_zoom200_Click" Visibility="Collapsed" />
                            <MenuItem x:Name="menuItem_zoom150" Header="150%" Click="menuItem_zoom150_Click" Visibility="Collapsed" />
                            <MenuItem x:Name="menuItem_zoom100" Header="100%" Click="menuItem_zoom100_Click"  />
                            <MenuItem x:Name="menuItem_zoom75" Header="75%" Click="menuItem_zoom75_Click"  />
                            <MenuItem x:Name="menuItem_zoom50" Header="50% (默认)" Click="menuItem_zoom50_Click" IsChecked="True"  />
                            <MenuItem x:Name="menuItem_zoom25" Header="25%" Click="menuItem_zoom25_Click"  />
                        </MenuItem>
                        <Slider x:Name="sld_zoomScale" Minimum="25" Maximum="100" Value="50" SmallChange="1" TickFrequency="10" LargeChange="10" ValueChanged="sld_zoomScale_ValueChanged" AutoToolTipPlacement="TopLeft"/>
                        <Separator/>
                        <MenuItem Header="立绘透明度" IsEnabled="False" />
                        <Slider x:Name="sld_alpha" Minimum="25" Maximum="100" Value="100" SmallChange="1" TickFrequency="10" LargeChange="10" AutoToolTipPlacement="TopLeft" ValueChanged="sld_alpha_ValueChanged"/>
                        <Separator/>
                        <MenuItem x:Name="menuItem_topmost" Header="立绘置顶" IsCheckable="True" IsChecked="True" Checked="menuItem_topmost_Checked" Unchecked="menuItem_topmost_Unchecked"/>
                        <MenuItem x:Name="mnenuItem_setPos"  Header="手动设置位置" Click="mnenuItem_setPos_Click" />
                        <MenuItem x:Name="menuItem_fixed" Header="固定位置" IsCheckable="True" Checked="menuItem_fixed_Checked" Unchecked="menuItem_fixed_Unchecked"/>
                        <MenuItem x:Name="menuItem_disableInteraction" Header="点击穿透" IsCheckable="True" Checked="menuItem_disableInteraction_Checked" Unchecked="menuItem_disableInteraction_Unchecked"/>
                        <Separator/>
                        <MenuItem x:Name="menuItem_Close" Header="关闭立绘" Click="menuItem_Close_Click"/>
                    </ContextMenu>
                </Image.ContextMenu>
            </Image>
        </Viewbox>
    </Grid>
</Window>
