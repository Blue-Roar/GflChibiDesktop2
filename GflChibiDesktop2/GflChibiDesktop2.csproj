<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Company>BrightSu</Company>
    <Product>GflChibiDesktop</Product>
    <AssemblyTitle>少女前线桌面Q宠</AssemblyTitle>
    <Description>少女前线桌面Q宠</Description>
    <Copyright>© 2020~2026 BrightSu</Copyright>
    <AssemblyVersion>2.1.1.1</AssemblyVersion>
    <FileVersion>2.1.1.1</FileVersion>
    <InformationalVersion>20260817</InformationalVersion>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <PackageProjectUrl>https://projects.brightsu.cn/GflChibiDesktop/V2/</PackageProjectUrl>
    <ApplicationIcon>hk416_happy.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="hk416_happy.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="hk416_happy.ico" />
    <Resource Include="hk416_angry.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="GflChibiDesktop\chibi_list.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <Link>app\chibi_list.json</Link>
    </None>
  </ItemGroup>

  <!-- HDTL 运行时（luajit、lua 模块、素材等），托管于 runtime/ 目录，拷贝到输出 app/ -->
  <ItemGroup>
    <Content Include="runtime\**\*" Exclude="runtime\instances\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>app\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- huMessageQueue.dll 由 Ipc.cs 通过 P/Invoke 加载，必须与主程序同目录 -->
    <None Include="huMessageQueue.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
