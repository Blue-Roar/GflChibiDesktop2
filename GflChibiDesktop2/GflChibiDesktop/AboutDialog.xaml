<UserControl x:Class="GflChibiDesktop.AboutDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d" 
             Width="500" Height="280" Foreground="White" >
    <hc:SimplePanel>
        <Border CornerRadius="10,10,0,0" Background="{DynamicResource PrimaryBrush}" Height="30" VerticalAlignment="Top">
            <hc:SimplePanel>
                <hc:SimpleText VerticalAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Stretch" TextAlignment="Center" Text="关于" Foreground="{StaticResource PrimaryTextBrush}"/>
                <Image RenderTransformOrigin="0,0" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" Height="24" Width="24" HorizontalAlignment="Left" Source="/hk416_happy.ico" VerticalAlignment="Top" Margin="3"/>
                <Button Width="24" Height="24" Style="{StaticResource ButtonIcon}" hc:IconElement.Geometry="{StaticResource ErrorGeometry}" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Command="hc:ControlCommands.Close" Margin="3" />
            </hc:SimplePanel>
        </Border>
        <Canvas Width="500" Height="250" VerticalAlignment="Bottom" Background="#FF1B1B1C">
            <Border CornerRadius="5" VerticalAlignment="Center" HorizontalAlignment="Right" Height="167" Width="300" Canvas.Left="10" Canvas.Top="10" Background="{DynamicResource PrimaryBrush}">
                <Canvas>
                    <Label Content="程序版本信息" Canvas.Left="10" Canvas.Top="5" Width="280" Height="27" FontSize="16" VerticalContentAlignment="Center" Background="{x:Null}" HorizontalContentAlignment="Center" BorderBrush="{x:Null}" Padding="0" />
                    <hc:TextBox IsReadOnly="True" x:Name="txt_version" Text="当前：Version/Build/BuildDate" Canvas.Left="10" Canvas.Top="24" Width="280" VerticalContentAlignment="Center" Background="{x:Null}" Padding="0" BorderBrush="{x:Null}" />
                    <hc:TextBox IsReadOnly="True" x:Name="txt_latest_version" Text="最新：Version/Build/BuildDate" Canvas.Left="10" Canvas.Top="42" Width="280" VerticalContentAlignment="Center" Background="{x:Null}" Padding="0" BorderBrush="{x:Null}" />
                    <Label x:Name="lbl_status" Content="版本状态" Canvas.Left="10" Canvas.Top="64" Width="280" Height="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Left" Background="{x:Null}" Padding="0" BorderBrush="{x:Null}" FontWeight="Bold" />
                    <hc:TextBox x:Name="txt_description" Canvas.Left="10" Canvas.Top="80" Width="280" Height="77" Padding="0" Background="{x:Null}" IsReadOnly="True" Text="版本更新内容信息&#xD;&#xA;1&#xD;&#xA;2&#xD;&#xA;3&#xD;&#xA;4" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" BorderThickness="0" TextWrapping="Wrap" BorderBrush="{x:Null}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                </Canvas>
            </Border>
            <Label Content="此程序仅供个人学习研究与交流用，严禁用于商业用途。&#xD;&#xA;作者不对因使用此程序而产生的各种后果承担任何责任。" Canvas.Left="10" Canvas.Top="183" Width="300" Height="33" VerticalContentAlignment="Top" Background="{x:Null}" HorizontalContentAlignment="Center" BorderBrush="{x:Null}" Padding="0" VerticalAlignment="Top" />
            <Label x:Name="lblCopyright" Content="© 2020~2026 BrightSu  / 由 HuiDesktop 驱动" Canvas.Left="10" Canvas.Top="221" Width="300" Height="19" VerticalContentAlignment="Bottom" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0" VerticalAlignment="Top" />
            <hc:SimpleText Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Center" Width="175" Text="开发者信息" Canvas.Left="315" Canvas.Top="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button x:Name="btn_BrightSu" Height="56" Width="175" Canvas.Left="315" Canvas.Top="30" Padding="0" Click="btn_BrightSu_Click" HorizontalAlignment="Left" Cursor="Hand">
                <StackPanel Orientation="Horizontal"  Width="167" Height="48">
                    <Image x:Name="avatar_BrightSu" RenderTransformOrigin="0,0" Height="48" Width="48" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" Source="/hk416_happy.ico" StretchDirection="Both" Stretch="UniformToFill" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,3,0"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <hc:SimpleText x:Name="name_BrightSu" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Center" TextWrapping="WrapWithOverflow" Width="116" Text="BrightSu02" HorizontalAlignment="Center" Margin="0" FontSize="13"/>
                        <hc:SimpleText Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="WrapWithOverflow" Width="116" Text="数据配置程序&#xD;&#xA;HDTLPanel适配" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button x:Name="btn_Huix" Height="56" Width="175" Canvas.Left="315" Canvas.Top="91" Padding="0" HorizontalContentAlignment="Center" Click="btn_Huix_Click" HorizontalAlignment="Left" Cursor="Hand">
                <StackPanel Orientation="Horizontal" Width="167" Height="48">
                    <Image x:Name="avatar_Huix" RenderTransformOrigin="0,0" Height="48" Width="48" UseLayoutRounding="True" RenderOptions.BitmapScalingMode="HighQuality" Source="/hk416_angry.ico" StretchDirection="Both" Stretch="UniformToFill" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,0,3,0"/>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <hc:SimpleText x:Name="name_Huix" Foreground="{StaticResource PrimaryTextBrush}" TextAlignment="Center" TextWrapping="WrapWithOverflow" Width="116" Text="老猫不发威&#xD;&#xA;你当我病危" HorizontalAlignment="Center" Margin="0" FontSize="13"/>
                        <hc:SimpleText Foreground="{StaticResource SecondaryTextBrush}" TextAlignment="Center" TextWrapping="WrapWithOverflow" Width="116" Text="HuiDesktop 主程序" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <hc:Rate Canvas.Left="317" Canvas.Top="151" ValueChanged="EasterEgg" VerticalAlignment="Center" Width="171" Count="6" HorizontalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            <Button x:Name="btn_Actions" Content="前往主页" Height="30" Width="175" Canvas.Left="315" Canvas.Top="175" Click="btn_Actions_Click" BorderThickness="2" Padding="0" VerticalAlignment="Top" />
            <Button x:Name="btn_Close" Content="确定" Height="30" Width="175" Canvas.Left="315" Canvas.Top="210" Command="hc:ControlCommands.Close" BorderThickness="2" IsCancel="True" IsDefault="True" Padding="0" HorizontalAlignment="Left" />
            <hc:LoadingLine Canvas.Left="428" Canvas.Top="167"/>
        </Canvas>
    </hc:SimplePanel>
</UserControl>