<Window x:Name="window" xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="HDTLPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDTLPanel"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainWindowDataContext, IsDesignTimeCreatable=True}"
        Title="HuiDesktop Light" Height="375" Width="520" Closing="Window_Closing" Closed="Window_Closed" StateChanged="Window_StateChanged" Background="#FF1B1B1C" Foreground="White" Icon="/GlobalIcon.ico">
    <Window.Resources>
        <local:BoolToStringValueConverter x:Key="runningStatusConverter"/>
        <local:ReverseBooleanValueConverter x:Key="reverseBooleanConverter"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="8*"/>
            <ColumnDefinition Width="5*"/>
        </Grid.ColumnDefinitions>
        <hc:NotifyIcon x:Name="notifyIcon" Text="{Binding Title, ElementName=window}" Visibility="Visible" Icon="/GlobalIcon.ico" MouseDoubleClick="notifyIcon_MouseDoubleClick" Grid.ColumnSpan="2">
            <hc:NotifyIcon.ContextMenu>
                <ContextMenu Width="120" >
                    <MenuItem Command="hc:ControlCommands.PushMainWindow2Top" Header="显示" Click="notifyIcon_MouseDoubleClick"/>
                    <Separator/>
                    <MenuItem Header="退出" Click="ExitApplication"/>
                </ContextMenu>
            </hc:NotifyIcon.ContextMenu>
        </hc:NotifyIcon>
        <Label Content="当前主程序状态：" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0,0,0,0" Height="20"/>
        <Label Content="{Binding Path=IsRunning, Converter={StaticResource ResourceKey=runningStatusConverter}, ConverterParameter=未运行/正在运行}" HorizontalAlignment="Left" Margin="121,10,0,0" VerticalAlignment="Top" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0,0,0,0" Height="20"/>
        <Label Content="版本" Margin="0,10,10,0" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="{StaticResource SecondaryTextBrush}" Background="{x:Null}" BorderBrush="{x:Null}" Padding="0,0,0,0" Grid.Column="1" Height="20"/>
        <Button Content="{Binding Path=IsRunning, Converter={StaticResource ResourceKey=runningStatusConverter}, ConverterParameter=启动程序/结束程序}" HorizontalAlignment="Left" Margin="10,39,0,0" VerticalAlignment="Top" Width="90" Click="SwitchSubprogramRunningStatus" IsEnabled="{Binding Path=IsBusyClosing, Converter={StaticResource reverseBooleanConverter}}"/>
        <Button Content="{Binding Path=IsAutoRun, Converter={StaticResource ResourceKey=runningStatusConverter}, ConverterParameter=开启自启/关闭自启}" Margin="0,39,0,0" VerticalAlignment="Top" Width="90" Click="ChangeAutoRun"/>
        <CheckBox VerticalAlignment="Top" HorizontalAlignment="Right" Content="将此窗口置顶" Margin="0,35,10,0" Width="100" Height="32" IsChecked="{Binding Topmost, ElementName=window}" Grid.Column="1" />
        <Grid x:Name="ConfigZoneGrid" Margin="0,72,0,0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Height="40" VerticalAlignment="Center" Background="{StaticResource DefaultBrush}">
                <Button Content="保存配置" HorizontalAlignment="Left" Margin="10,0,0,0" Width="90" IsEnabled="{Binding IsChanged}" Click="SaveConfig"/>
                <Button Content="放弃更改" HorizontalAlignment="Left" Margin="110,0,0,0" Width="90" IsEnabled="{Binding IsChanged}" Click="DiscardConfigChange"/>
                <Button Content="获取数据与生成配置" HorizontalAlignment="Right" Margin="0,0,10,0" Width="132" Click="GflChibiDesktop"/>
            </Grid>
            <ScrollViewer Margin="0,1,0,0" Grid.Row="1">
                <StackPanel x:Name="MainStackPanel"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
