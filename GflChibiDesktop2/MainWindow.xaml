<hc:Window x:Name="window" xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="GflChibiDesktop2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GflChibiDesktop2"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:MainWindowDataContext, IsDesignTimeCreatable=True}"
        Title="少女前线桌面Q宠" Height="375" Width="400" MinHeight="375" MinWidth="400" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing" Closed="Window_Closed" StateChanged="Window_StateChanged"
        Background="{DynamicResource SecondaryRegionBrush}" Foreground="{DynamicResource PrimaryTextBrush}" Icon="/hk416_happy.ico">
    <hc:Window.Resources>
        <local:BoolToStringValueConverter x:Key="runningStatusConverter"/>
    </hc:Window.Resources>
    <Grid>
        <hc:NotifyIcon x:Name="notifyIcon" Text="{Binding Title, ElementName=window}" Visibility="Visible" Icon="/hk416_happy.ico" MouseDoubleClick="notifyIcon_MouseDoubleClick">
            <hc:NotifyIcon.ContextMenu>
                <ContextMenu x:Name="trayMenu">
                    <MenuItem Command="hc:ControlCommands.PushMainWindow2Top" Header="显示主窗口(_S)" Click="notifyIcon_MouseDoubleClick"/>
                    <MenuItem Click="DataManager" Header="人形数据配置(_D)"/>
                    <Separator/>
                    <MenuItem Header="开机自启(_B)" IsCheckable="True" IsChecked="{Binding IsAutoRun}"/>
                    <Separator/>
                    <MenuItem Click="menuItemAbout_Click" Header="关于(_A)"/>
                    <Separator/>
                    <MenuItem Click="ExitApplication" Header="退出(_E)"/>
                </ContextMenu>
            </hc:NotifyIcon.ContextMenu>
        </hc:NotifyIcon>
        <Grid Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="48"/>
                <RowDefinition/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{StaticResource ThirdlyRegionBrush}">
                <Label Content="当前主实例状态：" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Center" Background="{x:Null}" BorderThickness="0" Padding="0,0,0,0" Height="20"/>
                <Label Content="{Binding Path=IsRunning, Converter={StaticResource ResourceKey=runningStatusConverter}, ConverterParameter=未运行/正在运行}" Foreground="{Binding Path=IsRunning, Converter={StaticResource ResourceKey=runningStatusConverter}, ConverterParameter=Red/Green}" HorizontalAlignment="Left" Margin="110,0,0,0" VerticalAlignment="Center" Background="{x:Null}" BorderThickness="0" Padding="0,0,0,0" Height="20" FontWeight="SemiBold"/>
                <CheckBox VerticalAlignment="Center" HorizontalAlignment="Right" Content="窗口置顶(_T)" Margin="0,0,10,0" Width="90" Height="20" IsChecked="{Binding Topmost, ElementName=window}" Grid.Column="1" />
            </Grid>
            <Grid Grid.Row="1">
                <Button Content="人形扩编(_E)" Style="{DynamicResource ButtonPrimary}" hc:IconElement.Geometry="{StaticResource AddGeometry}" HorizontalAlignment="Left" Margin="10,0,0,0" Padding="5" Width="100" Click="StartNewInstance" IsEnabled="{Binding HasActiveTab}" ToolTip="基于当前选中的桌宠配置，新开一个桌宠实例"/>
                <Button Content="删除当前(_W)" Style="{DynamicResource ButtonDanger}" hc:IconElement.Geometry="{StaticResource TrashGeometry}" HorizontalAlignment="Left" Margin="120,0,0,0" Padding="5" Width="100" Click="StopSelectedInstance" IsEnabled="{Binding HasActiveTab}" ToolTip="删除当前选中的桌宠实例"/>
                <ToggleButton Background="{DynamicResource RegionBrush}" Style="{StaticResource ToggleButtonSwitch}" Content="开机自启(_B)" HorizontalAlignment="Right" Margin="0,0,10,0" Width="125" IsChecked="{Binding IsAutoRun}" ToolTip="登录 Windows 时自动启动本程序" Height="28" HorizontalContentAlignment="Left" Grid.ColumnSpan="2"/>
            </Grid>
            <TabControl x:Name="PetTabs" Grid.Row="2" Margin="0,1,0,0" SelectionChanged="PetTabs_SelectionChanged" BorderThickness="0"/>
            <Grid Grid.Row="3">
                <Button Content="保存配置(_S)" Style="{DynamicResource ButtonDashedPrimary}"  hc:IconElement.Geometry="{StaticResource SaveGeometry}" HorizontalAlignment="Left" Margin="10,0,0,0" Width="100" IsEnabled="{Binding IsChanged}" Click="SaveConfig" Padding="5"/>
                <Button Content="放弃更改(_Q)" Style="{DynamicResource ButtonDashedDanger}" hc:IconElement.Geometry="{StaticResource DeleteGeometry}" HorizontalAlignment="Left" Margin="120,0,0,0" Width="100" IsEnabled="{Binding IsChanged}" Click="DiscardConfigChange" Padding="5"/>
                <Button Content="人形数据配置(_D)" hc:IconElement.Geometry="{StaticResource GearsGeometry}" HorizontalAlignment="Right" Padding="5" Width="130" Click="DataManager" VerticalAlignment="Center" Margin="0,0,10,0"/>
            </Grid>
        </Grid>
    </Grid>
</hc:Window>
