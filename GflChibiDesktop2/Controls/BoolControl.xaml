<UserControl xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="GflChibiDesktop2.BoolControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GflChibiDesktop2"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="400" Height="50">
    <Grid Height="50" VerticalAlignment="Top" d:DataContext="{d:DesignInstance {x:Type local:BoolControl}, IsDesignTimeCreatable=True}" Margin="0">
        <Border BorderBrush="{DynamicResource SecondaryBorderBrush}" BorderThickness="0, 1, 0, 0"/>
        <ToggleButton Style="{StaticResource ToggleButtonSwitch}" Content="{Binding Path=PromptText}" Grid.Row="1" Grid.Column="4" VerticalAlignment="Top" HorizontalAlignment="Center" IsChecked="{Binding Path=Choice}" Padding="0" Margin="10,4,10,0"/>
        <Label x:Name="HintTextBox" Content="{Binding Path=HintText}" Margin="10,0,10,4" Padding="0" VerticalAlignment="Bottom" Foreground="{StaticResource SecondaryTextBrush}" Background="{x:Null}" BorderThickness="0" HorizontalAlignment="Stretch" VerticalContentAlignment="Bottom"/>
    </Grid>
</UserControl>
